{
  "name": "job-application-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first, evidence-based job application workflows for AI coding agents",
  "type": "module",
  "bin": {
    "applykit": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc --project tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "privacy": "node scripts/privacy.mjs"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.2.0",
    "commander": "^14.0.0",
    "csv-parse": "^6.1.0",
    "docx": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.4.394",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
